{{ define "content" }}
  <section>
    <h1>Classes</h1>

    <p>Create the top-level classes for your notes platform.</p>

    {{ if .Error }}
      <p role="alert">{{ .Error }}</p>
    {{ end }}


    <section>
      <h2>Create Class</h2>

      <form method="post" action="/admin/classes">
        <input type="hidden" name="csrf_token" value="{{ .CSRFToken }}" />

        <div>
          <label for="name">Class Name</label>
          <input
            id="name"
            name="name"
            type="text"
            placeholder="Example: BCA, MCA, Class 10"
            required
          />
        </div>

        <div>
          <label for="description">Description</label>
          <textarea
            id="description"
            name="description"
            rows="3"
            placeholder="Optional short description"
          ></textarea>
        </div>

        <div>
          <label for="sort_order">Sort Order</label>
          <input id="sort_order" name="sort_order" type="number" value="0" />
        </div>

        <div>
          <label>
            <input name="is_published" type="checkbox" />
            Published
          </label>
        </div>

        <button type="submit">Create Class</button>
      </form>
    </section>

    <section>
      <h2>Existing Classes</h2>

      {{ with .Data.Classes }}
        <table>
          <thead>
            <tr>
              <th>Name</th>
              <th>Slug</th>
              <th>Published</th>
              <th>Sort Order</th>
              <th>Created At</th>
            </tr>
          </thead>

          <tbody>
            {{ range . }}
              <tr>
                <td>{{ .Name }}</td>
                <td>{{ .Slug }}</td>
                <td>{{ if .IsPublished }}Yes{{ else }}No{{ end }}</td>
                <td>{{ .SortOrder }}</td>
                <td>{{ .CreatedAt.Format "2006-01-02 15:04" }}</td>
              </tr>
            {{ end }}
          </tbody>
        </table>
      {{ else }}
        <p>No classes found.</p>
      {{ end }}
    </section>

    <p>
      <a href="/admin/dashboard">Back to dashboard</a>
    </p>
  </section>
{{ end }}
