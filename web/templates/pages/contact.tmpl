{{ define "content" }}
  <section class="mx-auto max-w-3xl space-y-8">
    <div>
      <span class="badge">Contact</span>
      <h1 class="page-title mt-4">Contact</h1>
      <p class="page-subtitle">
        For questions, corrections, or support related to notes and classroom
        materials, use the contact details below.
      </p>
    </div>

    <div class="card space-y-5 text-sm leading-7 text-academic-700">
      <div>
        <h2 class="text-lg font-semibold text-academic-900">Email</h2>
        <p class="mt-2">
          Replace this with your official support email before production:
        </p>
        <p class="mt-2">
          <a href="mailto:your-email@example.com">your-email@example.com</a>
        </p>
      </div>

      <div>
        <h2 class="text-lg font-semibold text-academic-900">
          Content corrections
        </h2>
        <p class="mt-2">
          If you find an error in any note or learning material, please mention
          the class, subject, unit, chapter, and note title when contacting us.
        </p>
      </div>
    </div>
  </section>
{{ end }}
