{{ define "content" }}
  <section>
    <h1>Subjects</h1>

    <p>Create subjects under a semester.</p>

    {{ if .Error }}
      <p role="alert">{{ .Error }}</p>
    {{ end }}


    <section>
      <h2>Create Subject</h2>

      <form method="post" action="/admin/subjects">
        <input type="hidden" name="csrf_token" value="{{ .CSRFToken }}" />

        <div>
          <label for="semester_id">Semester</label>
          <select id="semester_id" name="semester_id" required>
            <option value="">Select semester</option>
            {{ range .Data.Semesters }}
              <option value="{{ .ID }}">{{ .ClassName }} - {{ .Name }}</option>
            {{ end }}
          </select>
        </div>

        <div>
          <label for="name">Subject Name</label>
          <input
            id="name"
            name="name"
            type="text"
            placeholder="Example: Programming in C"
            required
          />
        </div>

        <div>
          <label for="description">Description</label>
          <textarea
            id="description"
            name="description"
            rows="3"
            placeholder="Optional short description"
          ></textarea>
        </div>

        <div>
          <label for="sort_order">Sort Order</label>
          <input id="sort_order" name="sort_order" type="number" value="0" />
        </div>

        <div>
          <label>
            <input name="is_published" type="checkbox" />
            Published
          </label>
        </div>

        <button type="submit">Create Subject</button>
      </form>
    </section>

    <section>
      <h2>Existing Subjects</h2>

      {{ with .Data.Subjects }}
        <table>
          <thead>
            <tr>
              <th>Class</th>
              <th>Semester</th>
              <th>Subject</th>
              <th>Slug</th>
              <th>Published</th>
              <th>Sort Order</th>
              <th>Created At</th>
            </tr>
          </thead>

          <tbody>
            {{ range . }}
              <tr>
                <td>{{ .ClassName }}</td>
                <td>{{ .SemesterName }}</td>
                <td>{{ .Name }}</td>
                <td>{{ .Slug }}</td>
                <td>{{ if .IsPublished }}Yes{{ else }}No{{ end }}</td>
                <td>{{ .SortOrder }}</td>
                <td>{{ .CreatedAt.Format "2006-01-02 15:04" }}</td>
              </tr>
            {{ end }}
          </tbody>
        </table>
      {{ else }}
        <p>No subjects found.</p>
      {{ end }}
    </section>

    <p>
      <a href="/admin/dashboard">Back to dashboard</a>
    </p>
  </section>
{{ end }}
