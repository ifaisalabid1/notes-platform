{{ define "content" }}
  <section class="space-y-8">
    <div>
      <span class="badge">Search</span>
      <h1 class="page-title mt-4">Search Notes</h1>
      <p class="page-subtitle">
        Search across published classes, subjects, chapters, and note files.
      </p>
    </div>

    <section class="card">
      <form
        method="get"
        action="/search"
        class="grid gap-4 sm:grid-cols-[1fr_auto] sm:items-end"
      >
        <div>
          <label for="q">Search notes</label>
          <input
            id="q"
            name="q"
            type="search"
            value="{{ .Data.Pagination.Query }}"
            placeholder="Example: C programming, DBMS, Unit 1..."
            autofocus
          />
        </div>

        <button type="submit" class="btn-primary">Search</button>
      </form>
    </section>

    {{ if .Data.Pagination.Query }}
      <section class="space-y-4">
        <div
          class="flex flex-col justify-between gap-3 sm:flex-row sm:items-end"
        >
          <div>
            <h2 class="section-title">Results</h2>
            <p class="mt-1 text-sm text-academic-500">
              {{ .Data.Pagination.TotalCount }}
              result{{ if ne .Data.Pagination.TotalCount 1 }}s{{ end }}
              for “{{ .Data.Pagination.Query }}”
            </p>
          </div>
        </div>

        {{ with .Data.Results }}
          <div class="grid gap-4 lg:grid-cols-2">
            {{ range . }}
              <article class="card">
                <div>
                  <span class="badge">{{ .Note.ContentType }}</span>

                  <h3 class="mt-4 text-xl font-semibold text-academic-900">
                    {{ .Note.Title }}
                  </h3>

                  <p class="mt-2 text-xs leading-5 text-academic-500">
                    {{ .Note.ClassName }} / {{ .Note.SemesterName }} /
                    {{ .Note.SubjectName }} / {{ .Note.UnitName }} /
                    {{ .Note.ChapterName }}
                  </p>

                  {{ if .Note.Description }}
                    <p class="mt-3 text-sm leading-6 text-academic-600">
                      {{ .Note.Description }}
                    </p>
                  {{ end }}


                  <dl
                    class="mt-5 grid gap-3 rounded-xl bg-academic-50 p-4 text-sm sm:grid-cols-2"
                  >
                    <div>
                      <dt class="font-medium text-academic-500">File</dt>
                      <dd class="mt-1 text-academic-800">
                        {{ .Note.OriginalFileName }}
                      </dd>
                    </div>

                    <div>
                      <dt class="font-medium text-academic-500">Size</dt>
                      <dd class="mt-1 text-academic-800">
                        {{ .Note.FileSizeBytes }} bytes
                      </dd>
                    </div>
                  </dl>

                  <div class="mt-5">
                    <a
                      href="/notes/{{ .Note.ID }}/view"
                      target="_blank"
                      rel="noopener noreferrer"
                      class="btn-primary"
                    >
                      View Notes
                    </a>
                  </div>
                </div>
              </article>
            {{ end }}
          </div>

          <div
            class="flex flex-col justify-between gap-3 pt-4 sm:flex-row sm:items-center"
          >
            <p class="text-sm text-academic-500">
              Page {{ $.Data.Pagination.Page }} of
              {{ if $.Data.Pagination.TotalPages }}
                {{ $.Data.Pagination.TotalPages }}
              {{ else }}
                1
              {{ end }}
            </p>

            <div class="flex gap-2">
              {{ if $.Data.Pagination.HasPrevious }}
                <a
                  href="{{ $.Data.Pagination.PreviousURL }}"
                  class="btn-secondary"
                  >Previous</a
                >
              {{ else }}
                <span class="btn-secondary cursor-not-allowed opacity-50"
                  >Previous</span
                >
              {{ end }}

              {{ if $.Data.Pagination.HasNext }}
                <a href="{{ $.Data.Pagination.NextURL }}" class="btn-secondary"
                  >Next</a
                >
              {{ else }}
                <span class="btn-secondary cursor-not-allowed opacity-50"
                  >Next</span
                >
              {{ end }}
            </div>
          </div>
        {{ else }}
          <div class="empty-state">
            <h3 class="empty-state-title">No matching notes found</h3>
            <p class="empty-state-text">
              Try searching with a subject name, chapter name, unit name, or a
              shorter keyword.
            </p>
          </div>
        {{ end }}
      </section>
    {{ else }}
      <div class="empty-state">
        <h3 class="empty-state-title">Search your study materials</h3>
        <p class="empty-state-text">
          Enter a keyword such as a subject, unit, chapter, or topic to find
          published notes.
        </p>
      </div>
    {{ end }}
  </section>
{{ end }}
