{{ define "content" }}
  <section class="space-y-8">
    <div
      class="flex flex-col justify-between gap-4 sm:flex-row sm:items-center"
    >
      <div>
        <span class="badge">Admin Area</span>

        <h1 class="page-title mt-4">Dashboard</h1>

        <p class="page-subtitle">
          Manage your Rising Star content, uploads, admins, and storage checks.
        </p>
      </div>

      <form method="post" action="/admin/logout">
        <input type="hidden" name="csrf_token" value="{{ .CSRFToken }}" />
        <button type="submit" class="btn-secondary">Logout</button>
      </form>
    </div>

    <section class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <div class="card">
        <p class="text-sm font-medium text-academic-500">Classes</p>
        <p class="mt-2 text-3xl font-bold text-academic-900">
          {{ .Data.Stats.Classes }}
        </p>
      </div>

      <div class="card">
        <p class="text-sm font-medium text-academic-500">Subjects</p>
        <p class="mt-2 text-3xl font-bold text-academic-900">
          {{ .Data.Stats.Subjects }}
        </p>
      </div>

      <div class="card">
        <p class="text-sm font-medium text-academic-500">Chapters</p>
        <p class="mt-2 text-3xl font-bold text-academic-900">
          {{ .Data.Stats.Chapters }}
        </p>
      </div>

      <div class="card">
        <p class="text-sm font-medium text-academic-500">Active Notes</p>
        <p class="mt-2 text-3xl font-bold text-brand-700">
          {{ .Data.Stats.ActiveNotes }}
        </p>
      </div>
    </section>

    <section class="grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
      <div class="rounded-2xl border border-academic-200 bg-white p-5">
        <p class="text-sm font-medium text-academic-500">Semesters</p>
        <p class="mt-2 text-2xl font-bold text-academic-900">
          {{ .Data.Stats.Semesters }}
        </p>
      </div>

      <div class="rounded-2xl border border-academic-200 bg-white p-5">
        <p class="text-sm font-medium text-academic-500">Units</p>
        <p class="mt-2 text-2xl font-bold text-academic-900">
          {{ .Data.Stats.Units }}
        </p>
      </div>

      <div class="rounded-2xl border border-academic-200 bg-white p-5">
        <p class="text-sm font-medium text-academic-500">Archived Notes</p>
        <p class="mt-2 text-2xl font-bold text-academic-900">
          {{ .Data.Stats.ArchivedNotes }}
        </p>
      </div>

      <div class="rounded-2xl border border-academic-200 bg-white p-5">
        <p class="text-sm font-medium text-academic-500">Admins</p>
        <p class="mt-2 text-2xl font-bold text-academic-900">
          {{ .Data.Stats.Admins }}
        </p>
      </div>

      <div class="rounded-2xl border border-academic-200 bg-white p-5">
        <p class="text-sm font-medium text-academic-500">Audit Events</p>
        <p class="mt-2 text-2xl font-bold text-academic-900">
          {{ .Data.Stats.AuditEvents }}
        </p>
      </div>
    </section>

    <section class="space-y-4">
      <div class="flex flex-col justify-between gap-3 sm:flex-row sm:items-end">
        <div>
          <h2 class="section-title">Popular Notes</h2>
          <p class="mt-1 text-sm text-academic-500">
            Most viewed notes by students.
          </p>
        </div>

        <a href="/admin/notes" class="btn-secondary">Manage notes</a>
      </div>

      {{ with .Data.PopularNotes }}
        <div
          class="overflow-hidden rounded-2xl border border-academic-200 bg-white"
        >
          <ul class="divide-y divide-academic-200">
            {{ range . }}
              <li class="p-4">
                <div
                  class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between"
                >
                  <div class="min-w-0">
                    <div class="flex flex-wrap items-center gap-2">
                      <h3
                        class="truncate text-base font-semibold text-academic-900"
                      >
                        {{ .Title }}
                      </h3>

                      {{ if .ArchivedAt }}
                        <span
                          class="rounded-full bg-red-50 px-2.5 py-1 text-xs font-medium text-red-700"
                        >
                          Archived
                        </span>
                      {{ else if .IsPublished }}
                        <span
                          class="rounded-full bg-green-50 px-2.5 py-1 text-xs font-medium text-green-700"
                        >
                          Published
                        </span>
                      {{ else }}
                        <span
                          class="rounded-full bg-academic-100 px-2.5 py-1 text-xs font-medium text-academic-600"
                        >
                          Draft
                        </span>
                      {{ end }}
                    </div>

                    <p class="mt-1 text-xs leading-5 text-academic-500">
                      {{ .ClassName }} / {{ .SemesterName }} /
                      {{ .SubjectName }} / {{ .UnitName }} /
                      {{ .ChapterName }}
                    </p>

                    <p class="mt-1 text-xs text-academic-500">
                      {{ .OriginalFileName }}
                    </p>
                  </div>

                  <div class="flex shrink-0 items-center gap-3">
                    <div class="text-right">
                      <p class="text-2xl font-bold text-brand-700">
                        {{ .ViewCount }}
                      </p>
                      <p class="text-xs text-academic-500">views</p>
                    </div>

                    <a href="/admin/notes/{{ .ID }}/edit" class="btn-secondary">
                      Edit
                    </a>
                  </div>
                </div>
              </li>
            {{ end }}
          </ul>
        </div>
      {{ else }}
        <div class="empty-state">
          <h3 class="empty-state-title">No note views yet</h3>
          <p class="empty-state-text">
            Popular notes will appear here after students start opening
            published notes.
          </p>
        </div>
      {{ end }}
    </section>

    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <a
        href="/admin/classes"
        class="card no-underline hover:border-brand-300 hover:shadow-md"
      >
        <span class="badge">Step 1</span>
        <h2 class="mt-4 text-lg font-semibold text-academic-900">Classes</h2>
        <p class="mt-2 text-sm leading-6 text-academic-600">
          Create and publish top-level classes.
        </p>
      </a>

      <a
        href="/admin/semesters"
        class="card no-underline hover:border-brand-300 hover:shadow-md"
      >
        <span class="badge">Step 2</span>
        <h2 class="mt-4 text-lg font-semibold text-academic-900">Semesters</h2>
        <p class="mt-2 text-sm leading-6 text-academic-600">
          Add semesters under each class.
        </p>
      </a>

      <a
        href="/admin/subjects"
        class="card no-underline hover:border-brand-300 hover:shadow-md"
      >
        <span class="badge">Step 3</span>
        <h2 class="mt-4 text-lg font-semibold text-academic-900">Subjects</h2>
        <p class="mt-2 text-sm leading-6 text-academic-600">
          Organize subjects inside semesters.
        </p>
      </a>

      <a
        href="/admin/units"
        class="card no-underline hover:border-brand-300 hover:shadow-md"
      >
        <span class="badge">Step 4</span>
        <h2 class="mt-4 text-lg font-semibold text-academic-900">Units</h2>
        <p class="mt-2 text-sm leading-6 text-academic-600">
          Split subjects into units.
        </p>
      </a>

      <a
        href="/admin/chapters"
        class="card no-underline hover:border-brand-300 hover:shadow-md"
      >
        <span class="badge">Step 5</span>
        <h2 class="mt-4 text-lg font-semibold text-academic-900">Chapters</h2>
        <p class="mt-2 text-sm leading-6 text-academic-600">
          Add chapters under units.
        </p>
      </a>

      <a
        href="/admin/notes"
        class="card no-underline hover:border-brand-300 hover:shadow-md"
      >
        <span class="badge">Step 6</span>
        <h2 class="mt-4 text-lg font-semibold text-academic-900">Notes</h2>
        <p class="mt-2 text-sm leading-6 text-academic-600">
          Upload files and publish notes.
        </p>
      </a>

      <a
        href="/admin/users"
        class="card no-underline hover:border-brand-300 hover:shadow-md"
      >
        <span class="badge">Owner only</span>
        <h2 class="mt-4 text-lg font-semibold text-academic-900">Admins</h2>
        <p class="mt-2 text-sm leading-6 text-academic-600">
          Create and review admin users.
        </p>
      </a>

      <a
        href="/admin/storage/readyz"
        class="card no-underline hover:border-brand-300 hover:shadow-md"
      >
        <span class="badge">Health</span>
        <h2 class="mt-4 text-lg font-semibold text-academic-900">R2 Storage</h2>
        <p class="mt-2 text-sm leading-6 text-academic-600">
          Check private Cloudflare R2 connectivity.
        </p>
      </a>

      <a
        href="/admin/account/password"
        class="card no-underline hover:border-brand-300 hover:shadow-md"
      >
        <span class="badge">Security</span>
        <h2 class="mt-4 text-lg font-semibold text-academic-900">Password</h2>
        <p class="mt-2 text-sm leading-6 text-academic-600">
          Change your admin account password.
        </p>
      </a>

      <a
        href="/admin/audit"
        class="card no-underline hover:border-brand-300 hover:shadow-md"
      >
        <span class="badge">Security</span>
        <h2 class="mt-4 text-lg font-semibold text-academic-900">Audit Log</h2>
        <p class="mt-2 text-sm leading-6 text-academic-600">
          Review recent admin actions.
        </p>
      </a>
    </div>
  </section>
{{ end }}
