{{ define "content" }}
  <section class="space-y-8">
    <div class="grid gap-8 lg:grid-cols-[1.2fr_0.8fr] lg:items-center">
      <div>
        <span class="badge">Classroom notes made simple</span>

        <h1
          class="mt-5 max-w-3xl text-4xl font-bold tracking-tight text-academic-900 sm:text-5xl"
        >
          Quality notes for better learning.
        </h1>

        <p class="mt-5 max-w-2xl text-base leading-7 text-academic-600">
          Browse class notes, subject materials, units, chapters, and
          downloadable resources shared by your teacher.
        </p>

        <div class="mt-6 flex flex-wrap gap-3">
          <a href="#classes" class="btn-primary">Browse Classes</a>
          <a href="/admin/login" class="btn-secondary">Admin Login</a>
        </div>
      </div>

      <div class="card">
        <div class="grid gap-4 sm:grid-cols-2">
          <div class="rounded-xl bg-brand-50 p-5">
            <p class="text-3xl font-bold text-brand-700">
              {{ len .Data.Classes }}
            </p>
            <p class="mt-1 text-sm text-academic-600">Published classes</p>
          </div>

          <div class="rounded-xl bg-academic-100 p-5">
            <p class="text-3xl font-bold text-academic-900">24/7</p>
            <p class="mt-1 text-sm text-academic-600">Access to notes</p>
          </div>

          <div class="rounded-xl bg-academic-100 p-5 sm:col-span-2">
            <p class="text-sm font-semibold text-academic-900">
              Private file delivery
            </p>
            <p class="mt-1 text-sm leading-6 text-academic-600">
              Notes are streamed securely without exposing the private storage
              URL.
            </p>
          </div>
        </div>
      </div>
    </div>

    {{ if .Data.LatestNotes }}
      <section class="space-y-4">
        <div
          class="flex flex-col justify-between gap-3 sm:flex-row sm:items-end"
        >
          <div>
            <h2 class="section-title">Latest Notes</h2>
            <p class="mt-1 text-sm text-academic-500">
              Recently published study materials.
            </p>
          </div>

          <a href="/search" class="btn-secondary">Search all notes</a>
        </div>

        <div
          class="overflow-hidden rounded-2xl border border-academic-200 bg-white"
        >
          <ul class="divide-y divide-academic-200">
            {{ range .Data.LatestNotes }}
              <li class="p-4 transition hover:bg-academic-50">
                <div
                  class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between"
                >
                  <div class="min-w-0">
                    <div class="flex flex-wrap items-center gap-2">
                      <h3
                        class="truncate text-base font-semibold text-academic-900"
                      >
                        {{ .Note.Title }}
                      </h3>

                      <span class="badge">{{ .Note.ContentType }}</span>
                    </div>

                    <p class="mt-1 text-xs leading-5 text-academic-500">
                      {{ .Note.ClassName }} / {{ .Note.SemesterName }} /
                      {{ .Note.SubjectName }} / {{ .Note.UnitName }} /
                      {{ .Note.ChapterName }}
                    </p>

                    {{ if .Note.Description }}
                      <p class="mt-2 text-sm leading-6 text-academic-600">
                        {{ .Note.Description }}
                      </p>
                    {{ end }}
                  </div>

                  <div class="flex shrink-0 items-center gap-3">
                    <span class="hidden text-xs text-academic-500 sm:inline">
                      {{ .Note.CreatedAt.Format "02 Jan 2006" }}
                    </span>

                    <a
                      href="{{ .FileURL }}"
                      target="_blank"
                      rel="noopener noreferrer"
                      class="btn-secondary"
                    >
                      View
                    </a>
                  </div>
                </div>
              </li>
            {{ end }}
          </ul>
        </div>
      </section>
    {{ end }}


    <section id="classes" class="space-y-4">
      <div>
        <h2 class="section-title">Available Classes</h2>
        <p class="page-subtitle">Start by choosing your class.</p>
      </div>

      {{ with .Data.Classes }}
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {{ range . }}
            <a
              href="/classes/{{ .Slug }}"
              class="card group no-underline hover:border-brand-300 hover:shadow-md"
            >
              <div class="flex items-start justify-between gap-4">
                <div>
                  <h3
                    class="text-lg font-semibold text-academic-900 group-hover:text-brand-700"
                  >
                    {{ .Name }}
                  </h3>

                  {{ if .Description }}
                    <p class="mt-2 text-sm leading-6 text-academic-600">
                      {{ .Description }}
                    </p>
                  {{ else }}
                    <p class="mt-2 text-sm leading-6 text-academic-600">
                      View semesters and notes for this class.
                    </p>
                  {{ end }}
                </div>

                <span
                  class="rounded-full bg-brand-50 px-3 py-1 text-xs font-semibold text-brand-700"
                >
                  Open
                </span>
              </div>
            </a>
          {{ end }}
        </div>
      {{ else }}
        <div class="empty-state">
          <h3 class="empty-state-title">Nothing available yet</h3>
          <p class="empty-state-text">
            Content will appear here once it is published by the admin.
          </p>
        </div>
      {{ end }}
    </section>
  </section>
{{ end }}
