{{ define "content" }}
  <section class="space-y-8">
    <div>
      <span class="badge">File Uploads</span>
      <h1 class="page-title mt-4">Notes</h1>
      <p class="page-subtitle">
        Upload notes under a chapter. Files are stored privately in Cloudflare
        R2 and viewed through the secure file proxy.
      </p>
    </div>

    {{ if .Error }}
      <div class="alert-error" role="alert">{{ .Error }}</div>
    {{ end }}


    <section class="card">
      <h2 class="section-title">Upload Note</h2>

      <form
        method="post"
        action="/admin/notes"
        enctype="multipart/form-data"
        class="mt-6 space-y-5"
      >
        <input type="hidden" name="csrf_token" value="{{ .CSRFToken }}" />

        <div class="grid gap-4 lg:grid-cols-5">
          <div>
            <label for="class_id">Class</label>
            <select
              id="class_id"
              name="class_id"
              hx-get="/admin/htmx/semesters"
              hx-target="#semester_id"
              hx-trigger="change"
              hx-include="#class_id"
              required
            >
              <option value="">Select class</option>
              {{ range .Data.Classes }}
                <option value="{{ .ID }}">{{ .Name }}</option>
              {{ end }}
            </select>
          </div>

          <div>
            <label for="semester_id">Semester</label>
            <select
              id="semester_id"
              name="semester_id"
              hx-get="/admin/htmx/subjects"
              hx-target="#subject_id"
              hx-trigger="change"
              hx-include="#semester_id"
              required
            >
              <option value="">Select semester</option>
            </select>
          </div>

          <div>
            <label for="subject_id">Subject</label>
            <select
              id="subject_id"
              name="subject_id"
              hx-get="/admin/htmx/units"
              hx-target="#unit_id"
              hx-trigger="change"
              hx-include="#subject_id"
              required
            >
              <option value="">Select subject</option>
            </select>
          </div>

          <div>
            <label for="unit_id">Unit</label>
            <select
              id="unit_id"
              name="unit_id"
              hx-get="/admin/htmx/chapters"
              hx-target="#chapter_id"
              hx-trigger="change"
              hx-include="#unit_id"
              required
            >
              <option value="">Select unit</option>
            </select>
          </div>

          <div>
            <label for="chapter_id">Chapter</label>
            <select id="chapter_id" name="chapter_id" required>
              <option value="">Select chapter</option>
            </select>
          </div>
        </div>

        <div class="form-grid">
          <div>
            <label for="title">Note Title</label>
            <input
              id="title"
              name="title"
              type="text"
              placeholder="Example: C Language Introduction Notes"
              required
            />
          </div>

          <div>
            <label for="sort_order">Sort Order</label>
            <input id="sort_order" name="sort_order" type="number" value="0" />
          </div>
        </div>

        <div>
          <label for="description">Description</label>
          <textarea
            id="description"
            name="description"
            rows="3"
            placeholder="Optional short description"
          ></textarea>
        </div>

        <div>
          <label for="file">File</label>
          <input id="file" name="file" type="file" required />
          <p class="mt-2 text-xs leading-5 text-academic-500">
            Allowed: PDF, JPG, PNG, WEBP, DOC, DOCX, PPTX, XLS, XLSX, TXT. Max
            size: 50 MB.
          </p>
        </div>

        <label class="inline-flex items-center gap-2">
          <input
            name="is_published"
            type="checkbox"
            class="h-4 w-4 rounded border-academic-300"
          />
          <span>Published</span>
        </label>

        <div>
          <button type="submit" class="btn-primary">Upload Note</button>
        </div>
      </form>
    </section>

    <section class="card">
      <form
        method="get"
        action="/admin/notes"
        class="grid gap-4 lg:grid-cols-[1fr_180px_140px_auto] lg:items-end"
      >
        <div>
          <label for="q">Search</label>
          <input
            id="q"
            name="q"
            type="search"
            value="{{ .Data.Pagination.Search }}"
            placeholder="Search title, file, class, subject, chapter..."
          />
        </div>

        <div>
          <label for="filter">Filter</label>
          <select id="filter" name="filter">
            <option
              value="active"
              {{ if eq .Data.Pagination.Filter "active" }}selected{{ end }}
            >
              Active
            </option>
            <option
              value="archived"
              {{ if eq .Data.Pagination.Filter "archived" }}selected{{ end }}
            >
              Archived
            </option>
            <option
              value="all"
              {{ if eq .Data.Pagination.Filter "all" }}selected{{ end }}
            >
              All
            </option>
          </select>
        </div>

        <div>
          <label for="per_page">Per page</label>
          <select id="per_page" name="per_page">
            <option
              value="10"
              {{ if eq .Data.Pagination.PerPage 10 }}selected{{ end }}
            >
              10
            </option>
            <option
              value="20"
              {{ if eq .Data.Pagination.PerPage 20 }}selected{{ end }}
            >
              20
            </option>
            <option
              value="50"
              {{ if eq .Data.Pagination.PerPage 50 }}selected{{ end }}
            >
              50
            </option>
            <option
              value="100"
              {{ if eq .Data.Pagination.PerPage 100 }}selected{{ end }}
            >
              100
            </option>
          </select>
        </div>

        <div class="flex gap-2">
          <button type="submit" class="btn-primary">Apply</button>
          <a href="/admin/notes" class="btn-secondary">Reset</a>
        </div>
      </form>
    </section>

    <section class="space-y-4">
      <div class="flex flex-col justify-between gap-3 sm:flex-row sm:items-end">
        <div>
          <h2 class="section-title">Existing Notes</h2>
          <p class="mt-1 text-sm text-academic-500">
            Showing page {{ .Data.Pagination.Page }} of
            {{ if .Data.Pagination.TotalPages }}
              {{ .Data.Pagination.TotalPages }}
            {{ else }}
              1
            {{ end }}
            · {{ .Data.Pagination.TotalCount }} total notes
          </p>
        </div>
      </div>

      {{ with .Data.Notes }}
        <div class="table-wrap overflow-x-auto">
          <table>
            <thead>
              <tr>
                <th>Hierarchy</th>
                <th>Title</th>
                <th>File</th>
                <th>Type</th>
                <th>Size</th>
                <th>Published</th>
                <th>Watermarked</th>
                <th>Archived</th>
                <th>Created At</th>
                <th>Actions</th>
              </tr>
            </thead>

            <tbody>
              {{ range . }}
                <tr>
                  <td>
                    <div class="max-w-xs text-xs leading-5 text-academic-600">
                      {{ .Note.ClassName }} / {{ .Note.SemesterName }} /
                      {{ .Note.SubjectName }} / {{ .Note.UnitName }} /
                      {{ .Note.ChapterName }}
                    </div>
                  </td>

                  <td class="font-medium text-academic-900">
                    {{ .Note.Title }}
                  </td>

                  <td>
                    <a
                      href="{{ .FileURL }}"
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {{ .Note.OriginalFileName }}
                    </a>
                  </td>

                  <td>{{ .Note.ContentType }}</td>
                  <td>{{ .Note.FileSizeBytes }} bytes</td>
                  <td>{{ if .Note.IsPublished }}Yes{{ else }}No{{ end }}</td>
                  <td>{{ if .Note.IsWatermarked }}Yes{{ else }}No{{ end }}</td>
                  <td>{{ if .Note.ArchivedAt }}Yes{{ else }}No{{ end }}</td>
                  <td>{{ .Note.CreatedAt.Format "2006-01-02 15:04" }}</td>

                  <td>
                    <div class="flex flex-wrap gap-2">
                      <a href="/admin/notes/{{ .Note.ID }}/edit">Edit</a>

                      {{ if .Note.ArchivedAt }}
                        <form
                          method="post"
                          action="/admin/notes/{{ .Note.ID }}/unarchive"
                        >
                          <input
                            type="hidden"
                            name="csrf_token"
                            value="{{ $.CSRFToken }}"
                          />
                          <button
                            type="submit"
                            class="text-sm font-medium text-brand-700 hover:text-brand-800"
                          >
                            Restore
                          </button>
                        </form>
                      {{ else }}
                        <form
                          method="post"
                          action="/admin/notes/{{ .Note.ID }}/archive"
                        >
                          <input
                            type="hidden"
                            name="csrf_token"
                            value="{{ $.CSRFToken }}"
                          />
                          <button
                            type="submit"
                            class="text-sm font-medium text-red-600 hover:text-red-700"
                          >
                            Archive
                          </button>
                        </form>
                      {{ end }}
                    </div>
                  </td>
                </tr>
              {{ end }}
            </tbody>
          </table>
        </div>

        <div
          class="flex flex-col justify-between gap-3 pt-4 sm:flex-row sm:items-center"
        >
          <p class="text-sm text-academic-500">
            Page {{ $.Data.Pagination.Page }} of
            {{ if $.Data.Pagination.TotalPages }}
              {{ $.Data.Pagination.TotalPages }}
            {{ else }}
              1
            {{ end }}
          </p>

          <div class="flex gap-2">
            {{ if $.Data.Pagination.HasPrevious }}
              <a
                href="{{ $.Data.Pagination.PreviousURL }}"
                class="btn-secondary"
                >Previous</a
              >
            {{ else }}
              <span class="btn-secondary cursor-not-allowed opacity-50"
                >Previous</span
              >
            {{ end }}

            {{ if $.Data.Pagination.HasNext }}
              <a href="{{ $.Data.Pagination.NextURL }}" class="btn-secondary"
                >Next</a
              >
            {{ else }}
              <span class="btn-secondary cursor-not-allowed opacity-50"
                >Next</span
              >
            {{ end }}
          </div>
        </div>
      {{ else }}
        <div class="card-muted">
          <p class="text-sm text-academic-600">No notes found.</p>
        </div>
      {{ end }}
    </section>

    <a href="/admin/dashboard" class="btn-secondary">Back to dashboard</a>
  </section>
{{ end }}
