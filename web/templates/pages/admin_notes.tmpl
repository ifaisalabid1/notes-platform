{{ define "content" }}
  <section>
    <h1>Notes</h1>

    <p>
      Upload notes under a chapter. Files are stored privately in Cloudflare R2.
    </p>

    {{ if .Error }}
      <p role="alert">{{ .Error }}</p>
    {{ end }}


    <section>
      <h2>Upload Note</h2>

      <form method="post" action="/admin/notes" enctype="multipart/form-data">
        <input type="hidden" name="csrf_token" value="{{ .CSRFToken }}" />

        <div>
          <label for="chapter_id">Chapter</label>
          <select id="chapter_id" name="chapter_id" required>
            <option value="">Select chapter</option>
            {{ range .Data.Chapters }}
              <option value="{{ .ID }}">
                {{ .ClassName }} - {{ .SemesterName }} - {{ .SubjectName }} -
                {{ .UnitName }} -
                {{ .Name }}
              </option>
            {{ end }}
          </select>
        </div>

        <div>
          <label for="title">Note Title</label>
          <input
            id="title"
            name="title"
            type="text"
            placeholder="Example: C Language Introduction Notes"
            required
          />
        </div>

        <div>
          <label for="description">Description</label>
          <textarea
            id="description"
            name="description"
            rows="3"
            placeholder="Optional short description"
          ></textarea>
        </div>

        <div>
          <label for="file">File</label>
          <input id="file" name="file" type="file" required />
          <p>
            Allowed: PDF, JPG, PNG, WEBP, DOC, DOCX, PPTX, XLS, XLSX, TXT. Max
            size: 50 MB.
          </p>
        </div>

        <div>
          <label for="sort_order">Sort Order</label>
          <input id="sort_order" name="sort_order" type="number" value="0" />
        </div>

        <div>
          <label>
            <input name="is_published" type="checkbox" />
            Published
          </label>
        </div>

        <button type="submit">Upload Note</button>
      </form>
    </section>

    <section>
      <h2>Existing Notes</h2>

      {{ with .Data.Notes }}
        <table>
          <thead>
            <tr>
              <th>Class</th>
              <th>Semester</th>
              <th>Subject</th>
              <th>Unit</th>
              <th>Chapter</th>
              <th>Title</th>
              <th>File</th>
              <th>Type</th>
              <th>Size</th>
              <th>Published</th>
              <th>Watermarked</th>
              <th>Created At</th>
            </tr>
          </thead>

          <tbody>
            {{ range . }}
              <tr>
                <td>{{ .Note.ClassName }}</td>
                <td>{{ .Note.SemesterName }}</td>
                <td>{{ .Note.SubjectName }}</td>
                <td>{{ .Note.UnitName }}</td>
                <td>{{ .Note.ChapterName }}</td>
                <td>{{ .Note.Title }}</td>
                <td>
                  <a
                    href="{{ .FileURL }}"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {{ .Note.OriginalFileName }}
                  </a>
                </td>
                <td>{{ .Note.ContentType }}</td>
                <td>{{ .Note.FileSizeBytes }} bytes</td>
                <td>{{ if .Note.IsPublished }}Yes{{ else }}No{{ end }}</td>
                <td>{{ if .Note.IsWatermarked }}Yes{{ else }}No{{ end }}</td>
                <td>{{ .Note.CreatedAt.Format "2006-01-02 15:04" }}</td>
              </tr>
            {{ end }}
          </tbody>
        </table>
      {{ else }}
        <p>No notes found.</p>
      {{ end }}
    </section>

    <p>
      <a href="/admin/dashboard">Back to dashboard</a>
    </p>
  </section>
{{ end }}
