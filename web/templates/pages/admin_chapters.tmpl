{{ define "content" }}
  <section class="space-y-8">
    <div>
      <span class="badge">Content Management</span>
      <h1 class="page-title mt-4">Chapters</h1>
      <p class="page-subtitle">Create chapters under a unit.</p>
    </div>

    {{ if .Error }}
      <div class="alert-error" role="alert">{{ .Error }}</div>
    {{ end }}


    <section class="card">
      <h2 class="section-title">Create Chapter</h2>

      <form method="post" action="/admin/chapters" class="mt-6 space-y-5">
        <input type="hidden" name="csrf_token" value="{{ .CSRFToken }}" />

        <div class="form-grid">
          <div>
            <label for="unit_id">Unit</label>
            <select id="unit_id" name="unit_id" required>
              <option value="">Select unit</option>
              {{ range .Data.Units }}
                <option value="{{ .ID }}">
                  {{ .ClassName }} - {{ .SemesterName }} - {{ .SubjectName }} -
                  {{ .Name }}
                </option>
              {{ end }}
            </select>
          </div>

          <div>
            <label for="name">Chapter Name</label>
            <input
              id="name"
              name="name"
              type="text"
              placeholder="Example: Introduction to C"
              required
            />
          </div>
        </div>

        <div class="form-grid">
          <div>
            <label for="sort_order">Sort Order</label>
            <input id="sort_order" name="sort_order" type="number" value="0" />
          </div>
        </div>

        <div>
          <label for="description">Description</label>
          <textarea
            id="description"
            name="description"
            rows="3"
            placeholder="Optional short description"
          ></textarea>
        </div>

        <label class="inline-flex items-center gap-2">
          <input
            name="is_published"
            type="checkbox"
            class="h-4 w-4 rounded border-academic-300"
          />
          <span>Published</span>
        </label>

        <div>
          <button type="submit" class="btn-primary">Create Chapter</button>
        </div>
      </form>
    </section>

    <section class="space-y-4">
      <h2 class="section-title">Existing Chapters</h2>

      {{ with .Data.Chapters }}
        <div class="table-wrap overflow-x-auto">
          <table>
            <thead>
              <tr>
                <th>Class</th>
                <th>Semester</th>
                <th>Subject</th>
                <th>Unit</th>
                <th>Chapter</th>
                <th>Slug</th>
                <th>Published</th>
                <th>Sort Order</th>
                <th>Created At</th>
              </tr>
            </thead>

            <tbody>
              {{ range . }}
                <tr>
                  <td>{{ .ClassName }}</td>
                  <td>{{ .SemesterName }}</td>
                  <td>{{ .SubjectName }}</td>
                  <td>{{ .UnitName }}</td>
                  <td class="font-medium text-academic-900">{{ .Name }}</td>
                  <td>{{ .Slug }}</td>
                  <td>{{ if .IsPublished }}Yes{{ else }}No{{ end }}</td>
                  <td>{{ .SortOrder }}</td>
                  <td>{{ .CreatedAt.Format "2006-01-02 15:04" }}</td>
                </tr>
              {{ end }}
            </tbody>
          </table>
        </div>
      {{ else }}
        <div class="card-muted">
          <p class="text-sm text-academic-600">No chapters found.</p>
        </div>
      {{ end }}
    </section>

    <a href="/admin/dashboard" class="btn-secondary">Back to dashboard</a>
  </section>
{{ end }}
