{{ define "content" }}
  <section class="space-y-8">
    <div>
      <nav class="text-sm text-academic-500">
        <a href="/" class="nav-link">Classes</a>
        <span class="mx-2">/</span>
        <a href="/classes/{{ .Data.Class.Slug }}" class="nav-link"
          >{{ .Data.Class.Name }}</a
        >
        <span class="mx-2">/</span>
        <a
          href="/classes/{{ .Data.Class.Slug }}/semesters/{{ .Data.Semester.Slug }}"
          class="nav-link"
          >{{ .Data.Semester.Name }}</a
        >
        <span class="mx-2">/</span>
        <a
          href="/classes/{{ .Data.Class.Slug }}/semesters/{{ .Data.Semester.Slug }}/subjects/{{ .Data.Subject.Slug }}"
          class="nav-link"
          >{{ .Data.Subject.Name }}</a
        >
        <span class="mx-2">/</span>
        <a
          href="/classes/{{ .Data.Class.Slug }}/semesters/{{ .Data.Semester.Slug }}/subjects/{{ .Data.Subject.Slug }}/units/{{ .Data.Unit.Slug }}"
          class="nav-link"
          >{{ .Data.Unit.Name }}</a
        >
        <span class="mx-2">/</span>
        <span>{{ .Data.Chapter.Name }}</span>
      </nav>

      <h1 class="page-title mt-4">{{ .Data.Chapter.Name }}</h1>

      {{ if .Data.Chapter.Description }}
        <p class="page-subtitle">{{ .Data.Chapter.Description }}</p>
      {{ else }}
        <p class="page-subtitle">View available notes for this chapter.</p>
      {{ end }}
    </div>

    {{ with .Data.Notes }}
      <div class="grid gap-4 lg:grid-cols-2">
        {{ range . }}
          <article class="card">
            <div class="flex items-start justify-between gap-4">
              <div>
                <span class="badge">{{ .Note.ContentType }}</span>

                <h2 class="mt-4 text-xl font-semibold text-academic-900">
                  {{ .Note.Title }}
                </h2>

                {{ if .Note.Description }}
                  <p class="mt-2 text-sm leading-6 text-academic-600">
                    {{ .Note.Description }}
                  </p>
                {{ end }}
              </div>
            </div>

            <dl
              class="mt-5 grid gap-3 rounded-xl bg-academic-50 p-4 text-sm sm:grid-cols-2"
            >
              <div>
                <dt class="font-medium text-academic-500">File size</dt>
                <dd class="mt-1 text-academic-800">
                  {{ .Note.FileSizeBytes }} bytes
                </dd>
              </div>

              <div>
                <dt class="font-medium text-academic-500">Watermarked</dt>
                <dd class="mt-1 text-academic-800">
                  {{ if .Note.IsWatermarked }}Yes{{ else }}No{{ end }}
                </dd>
              </div>
            </dl>

            <div class="mt-5">
              <a
                href="{{ .FileURL }}"
                target="_blank"
                rel="noopener noreferrer"
                class="btn-primary"
              >
                View Notes
              </a>
            </div>
          </article>
        {{ end }}
      </div>
    {{ else }}
      <div class="card-muted">
        <p class="text-sm text-academic-600">No notes are available yet.</p>
      </div>
    {{ end }}
  </section>
{{ end }}
