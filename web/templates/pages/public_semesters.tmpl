{{ define "content" }}
  <section class="space-y-8">
    <div>
      <nav class="text-sm text-academic-500">
        <a href="/" class="nav-link">Classes</a>
        <span class="mx-2">/</span>
        <span>{{ .Data.Class.Name }}</span>
      </nav>

      <h1 class="page-title mt-4">{{ .Data.Class.Name }}</h1>

      {{ if .Data.Class.Description }}
        <p class="page-subtitle">{{ .Data.Class.Description }}</p>
      {{ else }}
        <p class="page-subtitle">
          Choose a semester to continue browsing notes.
        </p>
      {{ end }}
    </div>

    {{ with .Data.Semesters }}
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {{ range . }}
          <a
            href="/classes/{{ $.Data.Class.Slug }}/semesters/{{ .Slug }}"
            class="card group no-underline hover:border-brand-300 hover:shadow-md"
          >
            <div class="flex items-start justify-between gap-4">
              <div>
                <h2
                  class="text-lg font-semibold text-academic-900 group-hover:text-brand-700"
                >
                  {{ .Name }}
                </h2>

                {{ if .Description }}
                  <p class="mt-2 text-sm leading-6 text-academic-600">
                    {{ .Description }}
                  </p>
                {{ else }}
                  <p class="mt-2 text-sm leading-6 text-academic-600">
                    View subjects for this semester.
                  </p>
                {{ end }}
              </div>

              <span class="badge">Semester</span>
            </div>
          </a>
        {{ end }}
      </div>
    {{ else }}
      <div class="empty-state">
        <h3 class="empty-state-title">Nothing available yet</h3>
        <p class="empty-state-text">
          Content will appear here once it is published by the admin.
        </p>
      </div>
    {{ end }}
  </section>
{{ end }}
