{{ define "content" }}
  <section class="space-y-8">
    <div>
      <nav class="text-sm text-academic-500">
        <a href="/" class="nav-link">Classes</a>
        <span class="mx-2">/</span>
        <a href="/classes/{{ .Data.Class.Slug }}" class="nav-link"
          >{{ .Data.Class.Name }}</a
        >
        <span class="mx-2">/</span>
        <a
          href="/classes/{{ .Data.Class.Slug }}/semesters/{{ .Data.Semester.Slug }}"
          class="nav-link"
          >{{ .Data.Semester.Name }}</a
        >
        <span class="mx-2">/</span>
        <a
          href="/classes/{{ .Data.Class.Slug }}/semesters/{{ .Data.Semester.Slug }}/subjects/{{ .Data.Subject.Slug }}"
          class="nav-link"
          >{{ .Data.Subject.Name }}</a
        >
        <span class="mx-2">/</span>
        <span>{{ .Data.Unit.Name }}</span>
      </nav>

      <h1 class="page-title mt-4">{{ .Data.Unit.Name }}</h1>

      {{ if .Data.Unit.Description }}
        <p class="page-subtitle">{{ .Data.Unit.Description }}</p>
      {{ else }}
        <p class="page-subtitle">Choose a chapter to view notes.</p>
      {{ end }}
    </div>

    {{ with .Data.Chapters }}
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {{ range . }}
          <a
            href="/classes/{{ $.Data.Class.Slug }}/semesters/{{ $.Data.Semester.Slug }}/subjects/{{ $.Data.Subject.Slug }}/units/{{ $.Data.Unit.Slug }}/chapters/{{ .Slug }}"
            class="card group no-underline hover:border-brand-300 hover:shadow-md"
          >
            <div class="flex items-start justify-between gap-4">
              <div>
                <h2
                  class="text-lg font-semibold text-academic-900 group-hover:text-brand-700"
                >
                  {{ .Name }}
                </h2>

                {{ if .Description }}
                  <p class="mt-2 text-sm leading-6 text-academic-600">
                    {{ .Description }}
                  </p>
                {{ else }}
                  <p class="mt-2 text-sm leading-6 text-academic-600">
                    View notes for this chapter.
                  </p>
                {{ end }}
              </div>

              <span class="badge">Chapter</span>
            </div>
          </a>
        {{ end }}
      </div>
    {{ else }}
      <div class="card-muted">
        <p class="text-sm text-academic-600">No chapters are available yet.</p>
      </div>
    {{ end }}
  </section>
{{ end }}
