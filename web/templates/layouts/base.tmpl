{{ define "base" }}
  <!doctype html>
  <html lang="en">
    <head>
      <meta charset="utf-8" />
      <meta name="viewport" content="width=device-width, initial-scale=1" />
      <title>{{ if .Title }}{{ .Title }} -{{ end }}Notes Platform</title>
    </head>
    <body>
      <main>
        {{ if .Flash }}
          <div role="status">{{ .Flash }}</div>
        {{ end }}

        {{ template "content" . }}
      </main>
    </body>
  </html>
{{ end }}
